<Window x:Class="FileProcessor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FileProcessor.Desktop.ViewModels"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Title="YJK 数据监控中心 - 旗舰版" Height="900" Width="1500"
        Background="#F0F2F5">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style TargetType="FrameworkElement" x:Key="VisibleIfTable">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChartMode}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#CCCFD3" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="📁 选择项目" Width="100" Height="30" Margin="0,0,15,0" Cursor="Hand"
                        Command="{Binding SelectProjectCommand}"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="监控路径: " Foreground="#666" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ProjectPath, TargetNullValue='未选择路径'}" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <Separator Margin="10,0"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock Text="当前塔号: " FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox Width="100" Height="26" 
                              ItemsSource="{Binding AvailableTowers}"
                              SelectedItem="{Binding CurrentTower}" />
                </StackPanel>

                <Separator Margin="10,0"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock Text="👀 当前查看版本: " Foreground="#666" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SelectedVersion.VersionId, TargetNullValue='未选择', FallbackValue='未选择'}" 
                               FontWeight="Bold" Foreground="#2563EB" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <Separator Margin="10,0"/>

                <Ellipse Width="10" Height="10" Fill="{Binding StatusColor, FallbackValue='#2ECC71'}" Margin="10,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusText, FallbackValue='正在实时监控...'}" VerticalAlignment="Center" Foreground="#27AE60" FontSize="12"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" MaxWidth="500"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="380" MinWidth="200" MaxWidth="500"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <GroupBox Header="计算版本记录" BorderBrush="#D1D5DB">
                    <ListBox ItemsSource="{Binding VersionHistory}" SelectedItem="{Binding SelectedVersion}" Margin="5" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="10" HorizontalAlignment="Stretch">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding VersionId}" 
               FontWeight="Bold" Foreground="#1F2937" FontSize="13" 
               TextTrimming="CharacterEllipsis" 
               VerticalAlignment="Center" Margin="0,0,10,0"
               ToolTip="{Binding VersionId}"/>
                                            <Border Grid.Column="1" Background="#F3F4F6" CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileCount, StringFormat='文件: {0}'}" 
                   Foreground="#6B7280" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>

                                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource {x:Type TextBox}}" 
                                                 Background="#F9FAFB" 
                                                 BorderBrush="#D1D5DB" 
                                                 BorderThickness="1" 
                                                 Padding="4" FontSize="12" Foreground="#4B5563"
                                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="26"
                                                 ToolTip="在此输入版本备注（如：增加底层柱截面）"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>
                <GroupBox Header="当前版本操作" Grid.Row="1" Margin="0,5,0,0" BorderBrush="#D1D5DB" Padding="5">
                    <Menu Background="Transparent" Margin="0,5" HorizontalAlignment="Stretch">
                        <MenuItem Header="📥 导出选中版本 ▾" Height="35" Width="215"
                                  Background="#EBFBEE" BorderBrush="#27AE60" BorderThickness="1" 
                                  FontSize="13" Foreground="#1F2937">
                            
                            <MenuItem Header="📗 导出为 Excel 多页报表" 
                                      Command="{Binding ExportCommand}" 
                                      Padding="10,5" FontSize="12"/>
                            
                            <MenuItem Header="📕 导出为 PDF 工程计算书" 
                                      Command="{Binding ExportPdfCommand}" 
                                      Padding="10,5" FontSize="12"/>
                        </MenuItem>
                    </Menu>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="1" 
                          Width="5" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch"
                          Background="#D1D5DB" 
                          Cursor="SizeWE" 
                          ToolTip="拖动以调整侧边栏宽度"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="220" MinHeight="200" MaxHeight="500"/>
                </Grid.RowDefinitions>

                <GroupBox Header="分项数据详情 (多视图插槽)" Margin="4">
                    <ItemsControl ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" Rows="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SlotViewModel}">
                                <Border BorderBrush="#E5E7EB" BorderThickness="1" Margin="3" Background="White"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">

                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="📄 导出为新 Excel 文件..." 
                                                      Command="{Binding PlacementTarget.Tag.ExportSlotToNewExcelCommand, 
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, 
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                                            <MenuItem Header="📥 追加到现有 Excel 文件..." 
                                                      Command="{Binding PlacementTarget.Tag.AppendSlotToExcelCommand, 
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, 
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="4">
                                            <DockPanel>
                                                <ToggleButton DockPanel.Dock="Right" Width="24" Height="22" Margin="4,0,0,0"
                                                              IsChecked="{Binding IsChartMode}" Cursor="Hand" ToolTip="切换 图表/表格">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Setter Property="Content" Value="🧮"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter Property="Content" Value="📊"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox Grid.Column="0" Margin="0,0,2,0" FontSize="11" 
                                                              ItemsSource="{Binding AvailableFiles}" SelectedItem="{Binding SelectedFile}"/>
                                                    <ComboBox Grid.Column="1" Margin="2,0,0,0" FontSize="11"
                                                              ItemsSource="{Binding AvailableBlocks}" SelectedItem="{Binding SelectedBlock}"/>
                                                </Grid>
                                            </DockPanel>
                                        </Border>

                                        <Grid Grid.Row="1">
                                            <DataGrid Style="{StaticResource VisibleIfTable}"
                                                      IsReadOnly="True" BorderThickness="0" Background="White"
                                                      ItemsSource="{Binding DisplayTable}"
                                                      AutoGenerateColumns="False" CanUserSortColumns="False" 
                                                      RowHeaderWidth="0" ColumnWidth="*">

                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Binding="{Binding Col0}">
                                                        <DataGridTextColumn.HeaderTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding DataContext.AvailableColumns, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                          SelectedItem="{Binding DataContext.TableCol1, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                          DisplayMemberPath="Header" BorderThickness="0" Background="Transparent" FontSize="10" FontWeight="Bold"/>
                                                            </DataTemplate>
                                                        </DataGridTextColumn.HeaderTemplate>
                                                    </DataGridTextColumn>

                                                    <DataGridTextColumn Binding="{Binding Col1}">
                                                        <DataGridTextColumn.HeaderTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding DataContext.AvailableColumns, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                          SelectedItem="{Binding DataContext.TableCol2, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                          DisplayMemberPath="Header" BorderThickness="0" Background="Transparent" FontSize="10" FontWeight="Bold"/>
                                                            </DataTemplate>
                                                        </DataGridTextColumn.HeaderTemplate>
                                                    </DataGridTextColumn>

                                                    <DataGridTextColumn Binding="{Binding Col2}">
                                                        <DataGridTextColumn.HeaderTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding DataContext.AvailableColumns, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                          SelectedItem="{Binding DataContext.TableCol3, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                          DisplayMemberPath="Header" BorderThickness="0" Background="Transparent" FontSize="10" FontWeight="Bold"/>
                                                            </DataTemplate>
                                                        </DataGridTextColumn.HeaderTemplate>
                                                    </DataGridTextColumn>

                                                    <DataGridTextColumn Binding="{Binding Col3}">
                                                        <DataGridTextColumn.HeaderTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding DataContext.AvailableColumns, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                          SelectedItem="{Binding DataContext.TableCol4, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                          DisplayMemberPath="Header" BorderThickness="0" Background="Transparent" FontSize="10" FontWeight="Bold"/>
                                                            </DataTemplate>
                                                        </DataGridTextColumn.HeaderTemplate>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <Grid Visibility="{Binding IsChartMode, Converter={StaticResource BoolToVisConverter}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <UniformGrid Grid.Row="0" Columns="2" Background="#F0F9FF" Margin="2">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="X轴:" VerticalAlignment="Center" FontSize="10" Foreground="#2563EB"/>
                                                        <ComboBox ItemsSource="{Binding AvailableColumns}" SelectedItem="{Binding ChartXCol}" DisplayMemberPath="Header" BorderThickness="0" Width="80" FontSize="10"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="Y轴:" VerticalAlignment="Center" FontSize="10" Foreground="#2563EB"/>
                                                        <ComboBox ItemsSource="{Binding AvailableColumns}" SelectedItem="{Binding ChartYCol}" DisplayMemberPath="Header" BorderThickness="0" Width="80" FontSize="10"/>
                                                    </StackPanel>
                                                </UniformGrid>

                                                <lvc:CartesianChart Grid.Row="1" Margin="5" Series="{Binding ChartSeries}">
                                                    <lvc:CartesianChart.AxisX>
                                                        <lvc:Axis Title="{Binding XAxisTitle}" />
                                                    </lvc:CartesianChart.AxisX>
                                                    <lvc:CartesianChart.AxisY>
                                                        <lvc:Axis Title="{Binding YAxisTitle}" />
                                                    </lvc:CartesianChart.AxisY>
                                                </lvc:CartesianChart>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <GridSplitter Grid.Row="1" 
                     Height="5" 
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Center"
                     Background="#D1D5DB" 
                     Cursor="SizeNS" 
                     ToolTip="拖动以调整侧边栏高度"/>

                <GroupBox Header="全局汇总数据 (固定展示)" Grid.Row="2" Margin="4" BorderBrush="#93C5FD" Background="White">
                    <DataGrid IsReadOnly="True" BorderThickness="0" ItemsSource="{Binding SummaryTable}"/>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="3" 
              Width="5" 
              HorizontalAlignment="Center" 
              VerticalAlignment="Stretch"
              Background="#D1D5DB" 
              Cursor="SizeWE" 
              ToolTip="拖动以调整侧边栏宽度"/>

            <GroupBox Header="参数趋势与对比分析" Grid.Column="4" Margin="6" BorderBrush="#D1D5DB">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="5">

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="📁 文件名 (File)" Grid.Row="0" Grid.Column="0" Margin="0,0,5,2" FontSize="11" Foreground="#666"/>
                            <ComboBox Grid.Row="1" Grid.Column="0" Margin="0,0,5,8" 
                                      ItemsSource="{Binding CompAvailableFiles}" SelectedItem="{Binding CompSelectedFile}"/>

                            <TextBlock Text="📄 数据块 (Block)" Grid.Row="0" Grid.Column="1" Margin="5,0,0,2" FontSize="11" Foreground="#666"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="5,0,0,8"
                                      ItemsSource="{Binding CompAvailableBlocks}" SelectedItem="{Binding CompSelectedBlock}"/>

                            <TextBlock Text="↕️ 基准列 (Y轴,如楼层)" Grid.Row="2" Grid.Column="0" Margin="0,0,5,2" FontSize="11" Foreground="#666"/>
                            <ComboBox Grid.Row="3" Grid.Column="0" Margin="0,0,5,8"
                                      ItemsSource="{Binding CompAvailableColumns}" SelectedItem="{Binding CompSelectedYAxis}"
                                      DisplayMemberPath="Header"/>

                            <TextBlock Text="↔️ 对比列 (X轴,如位移角)" Grid.Row="2" Grid.Column="1" Margin="5,0,0,2" FontSize="11" Foreground="#666"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" Margin="5,0,0,8"
                                      ItemsSource="{Binding CompAvailableColumns}" SelectedItem="{Binding CompSelectedXAxis}"
                                      DisplayMemberPath="Header"/>
                        </Grid>

                        <Button Content="📊 导出全版本横向对比表" Height="35" Margin="0,0,0,5" 
                                Background="#F0F7FF" BorderBrush="#2563EB" Command="{Binding ExportComparisonCommand}"/>
                        <Separator Margin="0,5"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Top" Height="250" Background="#F3F4F6" Margin="5" CornerRadius="4" BorderBrush="#E5E7EB" BorderThickness="1">
                        <lvc:CartesianChart Series="{Binding CompChartSeries}" LegendLocation="Bottom" Margin="10">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Title="{Binding CompXAxisTitle}"/>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="{Binding CompYAxisTitle}"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </Border>
                    
                    

                    <DataGrid Margin="5" IsReadOnly="True" BorderBrush="#EEE" Background="White" 
                              ItemsSource="{Binding CompDisplayTable}" AutoGenerateColumns="True" />
                </DockPanel>
            </GroupBox>
        </Grid>
    </Grid>
</Window>