<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- 插件项目通常需要这个为 true，确保依赖项也被拷贝到插件自己的 bin 目录 -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\FileProcessor.Core\FileProcessor.Core.csproj">
			<!-- 插件引用核心库，但不需要在运行时携带它，因为主程序已经有了 -->
			<Private>False</Private>
			<ExcludeAssets>runtime</ExcludeAssets>
		</ProjectReference>
	</ItemGroup>

	<!-- 自动化拷贝逻辑 -->
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<PropertyGroup>
			<!-- 增加一个回退机制：如果 SolutionDir 宏丢失，尝试向上级探测 -->
			<ActualSolutionDir Condition="'$(SolutionDir)' != ''">$(SolutionDir)</ActualSolutionDir>
			<ActualSolutionDir Condition="'$(SolutionDir)' == ''">..\</ActualSolutionDir>

			<!-- 定义最终的目标插件目录 -->
			<PluginTargetDir>$(SolutionDir)FileProcessor.TestConsole\bin\$(Configuration)\net10.0\Plugins\</PluginTargetDir>
		</PropertyGroup>

		<!-- 在输出日志中打印完整计算后的路径，方便你在控制台点击查看 -->
		<Message Text="[Build Debug] 源代码目录: $(TargetDir)" Importance="high" />
		<Message Text="[Build Debug] 目标同步目录: $(PluginTargetDir)" Importance="high" />

		<!-- 路径存在性预检 -->
		<Error Condition="!Exists('$(ActualSolutionDir)UI\')" Text="[Build Error] 未找到 UI 项目目录，请检查路径配置：$(ActualSolutionDir)UI\" />

		<MakeDir Directories="$(PluginTargetDir)" />

		<!-- 拷贝 DLL -->
		<Copy SourceFiles="$(TargetDir)$(TargetName).dll" DestinationFolder="$(PluginTargetDir)" SkipUnchangedFiles="true" />

		<!-- 拷贝 PDB (调试信息) -->
		<Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(PluginTargetDir)" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />

		<Message Text="[Build Success] 插件已成功同步至目标目录！" Importance="high" />
	</Target>

</Project>